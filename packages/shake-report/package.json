{
  "name": "@react-native-tree-shaker/shake-report",
  "version": "0.0.0",
  "description": "Measures React Native bundles: raw, gzip, brotli and Hermes bytecode size, module count, and bytes per package.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodespire/react-native-tree-shaker.git",
    "directory": "packages/shake-report"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "shake-report": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31"
  },
  "devDependencies": {
    "@jridgewell/gen-mapping": "^0.3.13"
  }
}
