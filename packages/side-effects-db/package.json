{
  "name": "@metro-tree-shaker/side-effects-db",
  "version": "0.0.0",
  "description": "Resolves package sideEffects for tree shaking, with curated overrides for React Native libraries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodespire/react-native-tree-shaker.git",
    "directory": "packages/side-effects-db"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data/side-effects.json": "./data/side-effects.json",
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "schema.json"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "picomatch": "^4.0.2",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.0",
    "@types/semver": "^7.7.0"
  }
}
