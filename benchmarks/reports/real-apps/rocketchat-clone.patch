+// Added for react-native-tree-shaker benchmarks: Expo's transformer loads this config
+// without a filename, which Babel rejects for `exclude` patterns. The override
+// only excludes test files, so apply its plugins everywhere instead.
+if (process.env.USE_EXPO_METRO) {
+	const { overrides, ...rest } = module.exports;
+	const compiler = process.env.NO_REACT_COMPILER ? [] : overrides.flatMap(o => o.plugins);
+	module.exports = { ...rest, plugins: [...rest.plugins, ...compiler] };
+}
